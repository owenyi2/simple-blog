<!-- "pandoc -H file" option embeds the text from "file" directly. So this is a file with CSS but wrapped in HTML <style> tags. Don't @ me. Actually do @ me if you have a nice **simple** fix because this also hurts my aesthetic sensibilities -->
<style>
/* Justify text */
body {
    text-align: justify;
}
h2, h3, h4, h5, h6 {
    text-align: left;
}

/* Give Code Blocks more margin */
pre {
    margin: 20px 0; /* top & bottom margin */
    padding: 15px;  /* internal padding for readability */
    background-color: #f5f5f5; /* optional: light gray background */
    border-radius: 5px; /* optional: rounded corners */
    overflow-x: auto;  /* horizontal scroll if code is long */
}

/* Inline code styling */
code {
    padding: 2px 4px;
    background-color: #eee;
    border-radius: 3px;
    line-height: 1.4;     /* spacing for inline code */
}

</style>
